        <mxCell id="s1" parent="phase1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#eaf2fb;strokeColor=#6b91bd;strokeWidth=2;fontColor=#1e293b;fontSize=15;align=left;verticalAlign=middle;spacing=12;" value="&lt;b&gt;Этап 1. Подача рукописи&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Цель:&lt;/b&gt; зарегистрировать статью.&lt;br&gt;&lt;b&gt;Участники:&lt;/b&gt; автор, OJS.&lt;br&gt;&lt;b&gt;Вход:&lt;/b&gt; DOCX/LaTeX, метаданные, авторы.&lt;br&gt;&lt;b&gt;Выход:&lt;/b&gt; заявка создана." vertex="1">
